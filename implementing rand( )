import numpy as np 

a=np.random.rand(5)
print("Random number using rand() : ")
print(a)

b=np.random.randn(5)
print("\nRandom number using randn() : ")
print(b)

c=np.random.randint(1,50,5)
print("\nRandom integres using randint() : ")
print(c)

d=np.random.normal(50,10,5)
print("\nNumbers using normal() : ")
print(d)

print("\nStatistics of normal distribution : ")
print("\nMean = ",np.mean(d))
print("\nMedian = ",np.median(d))
print("\nStandard Deviation = ",np.std(d))
print("\nMinimum = ",np.min(d))
print("\nMaximum = ",np.max(d))
