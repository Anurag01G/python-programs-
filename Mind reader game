
import random

print("================================")
print("       MIND READER GAME")
print("================================")
print("Predict the computer's next move!")
print("Choose: 1, 2, or 3")
print("1 = Fire  2 = Water  3 = Earth")

moves = {1: "Fire", 2: "Water", 3: "Earth"}

score = 0
streak = 0
rounds = 5

for i in range(rounds):
    print("\nRound", i + 1)

    try:
        guess = int(input("Predict the move (1-3): "))
    except ValueError:
        print("Invalid input! Round skipped.")
        continue

    if guess not in moves:
        print("Choose only 1, 2, or 3!")
        continue

    computer = random.randint(1, 3)

    print("Your prediction:", moves[guess])
    print("Computer's move:", moves[computer])

    if guess == computer:
        score += 10
        streak += 1
        print("Amazing! You read its mind!")
        print("Current streak:", streak)
    else:
        streak = 0
        print("Wrong prediction! Try again.")

print("\n======= FINAL RESULT =======")
print("Your score:", score, "/ 50")

if score >= 40:
    print("You are a Mind Reader!")
elif score >= 20:
    print("Good prediction skills!")
else:
    print("Keep training your mind!")

print("Thanks for playing!")
