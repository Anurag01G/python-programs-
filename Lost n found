items = []

while True:
    print("\n--- Lost & Found System ---")
    print("1. Report Lost Item")
    print("2. Search Item")
    print("3. View All Items")
    print("4. Exit")

    choice = input("Enter choice: ")

    if choice == "1":
        name = input("Enter item name: ")
        place = input("Where was it lost? ")
        items.append({"name": name, "place": place})
        print("Item reported successfully!")

    elif choice == "2":
        search = input("Enter item name to search: ")
        found = False

        for item in items:
            if search.lower() in item["name"].lower():
                print("Item:", item["name"])
                print("Lost at:", item["place"])
                found = True

        if not found:
            print("Item not found.")

    elif choice == "3":
        for item in items:
            print(item["name"], "-", item["place"])

    elif choice == "4":
        break

    else:
        print("Invalid choice!")
